<form string="Employé" js_class="hr_employee_form">
  <header>
    <button name="action_create_user" string="Créer un utilisateur" type="object" invisible="user_id"/>
  </header>
  <sheet>
    <div name="button_box" class="oe_button_box">
      <button name="action_open_attendances" type="object" class="oe_stat_button" icon="fa-clock-o">
        <field name="hours_last_month" widget="statinfo" string="Heures"/>
      </button>
    </div>
    <field name="avatar_128" invisible="1"/>
    <field name="image_1920" widget="image" class="oe_avatar"/>
    <div class="oe_title">
      <h1><field name="name" placeholder="Nom de l'employé" required="True"/></h1>
      <h2><field name="job_title" placeholder="Intitulé du poste"/></h2>
      <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
    </div>
    <group>
      <group string="Contact">
        <field name="work_email" widget="email"/>
        <field name="work_phone"/>
        <field name="mobile_phone" invisible="not work_phone"/>
      </group>
      <group string="Organisation">
        <field name="department_id"/>
        <field name="parent_id" widget="many2one_avatar_user"/>
        <field name="coach_id" readonly="not parent_id"/>
        <field name="company_id" groups="base.group_multi_company"/>
      </group>
    </group>
    <notebook>
      <page name="public" string="Informations professionnelles">
        <group>
          <field name="work_location_id" domain="[('active', '=', True)]"/>
          <field name="resource_calendar_id" domain="[('company_id', 'in', [company_id, False])]"/>
          <field name="tz" required="context.get('tz_required')"/>
        </group>
      </page>
      <page name="personal_information" string="Informations privées" groups="hr.group_hr_user">
        <group>
          <field name="private_email"/>
          <field name="ssnid"/>
          <field name="marital"/>
          <field name="spouse_complete_name" invisible="marital not in ['married', 'cohabitant']"/>
        </group>
      </page>
      <page name="hr_settings" string="Paramètres RH" groups="hr.group_hr_user">
        <group>
          <field name="employee_type"/>
          <field name="user_id" readonly="id and uid"/>
        </group>
      </page>
    </notebook>
  </sheet>
  <chatter/>
</form>
