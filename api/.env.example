# mock : données en mémoire, sans Odoo
# odoo : ta base Odoo 18 avec leila_hr installé
ADAPTER=odoo
API_PORT=3001

# --- Uniquement si ADAPTER=odoo ---
# Depuis le conteneur api, une Odoo lancée par le profil compose "odoo-local" est sur http://odoo:8069
ODOO_URL=https://erp.ts.beatitude973.fr/
ODOO_DB=amg
ODOO_LANG=fr_FR
ODOO_TZ=America/Cayenne

# Un compte Odoo par rôle (PoC, en attendant l'identité réelle via Keycloak).
# Mot de passe OU clé d'API (recommandé : Préférences > Sécurité du compte > Nouvelle clé d'API).
ODOO_USER_EMPLOYEE=admin
ODOO_PASSWORD_EMPLOYEE=admin
ODOO_USER_MANAGER=employee1
ODOO_PASSWORD_MANAGER=employee1
ODOO_USER_HR_ADMIN=demorh
ODOO_PASSWORD_HR_ADMIN=demorh

# Tests contre Odoo (base de RECETTE uniquement)
# ODOO_TEST_EMPLOYEE_ID=42
