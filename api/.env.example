# mock : données en mémoire, sans Odoo
# odoo : ta base Odoo 18 avec leila_hr installé
ADAPTER=odoo
API_PORT=3001

# Identité (cahier de dev § 2.3)
#  shared       : comptes Odoo partagés par rôle, viewer déclaré par le front (en-têtes x-viewer-*)
#  odoo-session : chaque utilisateur se connecte avec SES identifiants Odoo (ADAPTER=odoo)
#  fake-jwt     : démo de l'identité réelle sur le mock (ADAPTER=mock) — abigail / bruno / camille
AUTH_MODE=shared
# FAKE_JWT_PASSWORD=demo

# Sessions Leila (modes odoo-session et fake-jwt)
# COOKIE_SECURE=0 en local http uniquement (Safari refuse les cookies Secure sur http://localhost)
COOKIE_SECURE=0
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=8
LOGIN_ATTEMPTS_PER_MINUTE=5
# 1 : l'IP du client vient de X-Forwarded-For (API joignable uniquement par le front)
# TRUST_PROXY=1

# Groupes Odoo → rôle Leila (présentation seulement ; à vérifier sur la base, Q-02)
# ROLE_GROUPS=hr_admin=hr.group_hr_manager;manager=hr_attendance.group_hr_attendance_officer,hr.group_hr_user
# Groupe requis pour approuver/refuser les heures ; vide = pouvoir modifier le pointage suffit
# APPROVAL_GROUP=hr_attendance.group_hr_attendance_officer

# --- Uniquement si ADAPTER=odoo ---
# Depuis le conteneur api, une Odoo lancée par le profil compose "odoo-local" est sur http://odoo:8069
ODOO_URL=https://erp.ts.beatitude973.fr/
ODOO_DB=amg
ODOO_LANG=fr_FR
ODOO_TZ=America/Cayenne

# Un compte Odoo par rôle (AUTH_MODE=shared seulement ; inutiles en odoo-session).
# Mot de passe OU clé d'API (recommandé : Préférences > Sécurité du compte > Nouvelle clé d'API).
ODOO_USER_EMPLOYEE=admin
ODOO_PASSWORD_EMPLOYEE=admin
ODOO_USER_MANAGER=employee1
ODOO_PASSWORD_MANAGER=employee1
ODOO_USER_HR_ADMIN=demorh
ODOO_PASSWORD_HR_ADMIN=demorh

# Tests contre Odoo. Toute suite qui écrit s'arrête si ODOO_DB n'est pas dans cette liste.
ODOO_WRITE_ALLOWED_DBS=amg
# ODOO_TEST_EMPLOYEE_ID=42
# ODOO_TEST_WRITES=1

# Contrat d'identité et contrat des ports en odoo-session (profils de test, § 4.2)
# ODOO_IDENTITY_LOGIN=p.manager
# ODOO_IDENTITY_PASSWORD=
# ODOO_IDENTITY_ROLE=manager
# ODOO_IDENTITY_OTHER_LOGIN=p.employe
# ODOO_IDENTITY_OTHER_PASSWORD=
# ODOO_IDENTITY_OTHER_ROLE=employee

# Matrice de droits (T-60) : copier rights-matrix.config.example.json et le compléter (T-03)
# RIGHTS_MATRIX_CONFIG=rights-matrix.config.json
# MATRIX_PASSWORD_ADMIN=
# MATRIX_PASSWORD_MANAGER=
# MATRIX_PASSWORD_VALIDATEUR=
# MATRIX_PASSWORD_EMPLOYE=
# MATRIX_PASSWORD_AUTRE_SOCIETE=






