{
  "name": "poc-odoo-repository-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --prefix ../packages/ui-schema --silent",
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "pretypecheck": "npm run build --prefix ../packages/ui-schema --silent",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "pretest": "npm run build --prefix ../packages/ui-schema --silent",
    "test": "node --import tsx --test test/*.test.ts",
    "rapport": "tsx scripts/rapport-identite.ts",
    "presimulateur": "npm run build --prefix ../packages/ui-schema --silent",
    "simulateur": "tsx scripts/odoo-simulateur.ts",
    "inventaire": "tsx scripts/inventaire-vues.ts",
    "classement": "tsx scripts/classement.ts",
    "sonde-portail": "tsx scripts/sonde-portail.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@leila/ui-schema": "1.0.0",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "5.11.2",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  }
}
