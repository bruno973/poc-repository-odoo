# URL de l'API vue depuis le serveur Astro.
# En docker compose, elle est imposée à http://api:3001 (voir docker-compose.yml).
API_BASE_URL=http://api:3001

# Viewer du PoC (en attendant Keycloak). Lu côté serveur uniquement :
# le navigateur ne peut pas le changer.
# employee | manager | hr_admin  (défaut : employee, le moins de droits)
VIEWER_ROLE=hr_admin
VIEWER_ID=1
# Employé correspondant au viewer (règle « self ») ; défaut : VIEWER_ID
# VIEWER_EMPLOYEE_ID=1
# VIEWER_DEPARTMENT_ID=
