---
// components/TreeForm.astro
// Parcourt le formTree DÉJÀ HYDRATÉ ET ÉLAGUÉ par l'API : value + editable posés,
// nœuds invisibles pour ce viewer déjà retirés côté serveur. Le front n'évalue
// plus aucune règle de visibilité : il affiche ce qu'il reçoit.

import type {
  EmployeeFormRecord,
  GroupNode,
  FormNode,
} from "../types/domain.js";

import Leaf from "./nodes/Leaf.astro";
import GroupNodeComp from "./nodes/GroupNode.astro";

interface Props {
  record: EmployeeFormRecord;
}

const { record } = Astro.props;

const tabs: GroupNode[] = record.formTree;

const activeTab = Astro.url.searchParams.get("tab") ?? tabs[0]?.key ?? "";

---

<nav class="tabs" role="tablist">
  {tabs.map((tab) => (
    <a
      href={`?tab=${tab.key}`}
      class={`tabs__tab${activeTab === tab.key ? " tabs__tab--active" : ""}`}
      role="tab"
      aria-selected={activeTab === tab.key ? "true" : "false"}
    >
      {tab.label}
    </a>
  ))}
</nav>

<form
  method="post"
  id="employee-form"
  data-employee-id={record.id}
>
  {tabs.map((tab) => (
    <div
      class="tab-content"
      role="tabpanel"
      style={activeTab === tab.key ? "" : "display: none;"}
    >
      {tab.children.map((node: FormNode) =>
        node.kind === "group" ? (
          <GroupNodeComp label={node.label}>
            {node.children.map((child: FormNode) => <Leaf node={child} />)}
          </GroupNodeComp>
        ) : (
          <Leaf node={node} />
        )
      )}
    </div>
  ))}

  <div class="form-actions">
    <button type="submit" class="btn-save">💾 Enregistrer</button>
    <span class="save-status" id="save-status"></span>
  </div>
</form>

<style>
  .tabs {
    display: flex;
    gap: 4px;
    border-bottom: 2px solid #e0e4f5;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .tabs__tab {
    padding: 8px 18px;
    text-decoration: none;
    font-size: 0.9rem;
    color: #666;
    border-radius: 6px 6px 0 0;
    border: 1px solid transparent;
    border-bottom: none;
    transition: background 0.15s;
  }
  .tabs__tab:hover {
    background: #f0f3ff;
    color: #4c6ef5;
  }
  .tabs__tab--active {
    background: #fff;
    color: #4c6ef5;
    font-weight: 600;
    border-color: #e0e4f5;
    margin-bottom: -2px;
  }
  .tab-content {
    padding: 0.5rem 0;
  }
  .form-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid #e0e4f5;
  }
  .btn-save {
    padding: 10px 24px;
    background: #4c6ef5;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  .btn-save:hover {
    background: #3b5bdb;
  }
  .save-status {
    font-size: 0.85rem;
    color: #888;
  }
</style>

<script>
  const form = document.getElementById("employee-form") as HTMLFormElement | null;
  const status = document.getElementById("save-status");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !status) return;

    const employeeId = form.dataset.employeeId;

    const formData = new FormData(form);
    const patch: Record<string, string> = {};
    for (const [key, value] of formData.entries()) {
      patch[key] = String(value);
    }

    status.textContent = "Enregistrement…";

    try {
      const res = await fetch(`/api/employees/${employeeId}`, {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(patch),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        status.textContent = `Erreur : ${err.message ?? err.error ?? res.statusText}`;
        return;
      }

      status.textContent = "✅ Enregistré";
      setTimeout(() => { if (status) status.textContent = ""; }, 3000);
    } catch (err) {
      status.textContent = "Erreur réseau";
    }
  });
</script>
