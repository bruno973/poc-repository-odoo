---
// components/nodes/GroupNode.astro
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<section class="group">
  <h3 class="group__title">{label}</h3>
  <div class="group__body">
    <slot />
  </div>
</section>

<style>
  .group {
    margin-bottom: 1.5rem;
  }
  .group__title {
    font-size: 0.85rem;
    font-weight: 600;
    color: #555;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.5rem 0;
    padding-bottom: 4px;
    border-bottom: 2px solid #e8e8e8;
  }
  .group__body {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0 2rem;
  }
</style>
