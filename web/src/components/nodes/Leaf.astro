---
// components/nodes/Leaf.astro — Rend une feuille du formTree selon son type.
// Remplace la table { Component, props } de TreeForm, que le mode strict de
// TypeScript (exactOptionalPropertyTypes) refusait de typer.
import type { FormNode } from "../../types/domain.js";
import TextField from "./TextField.astro";
import SelectField from "./SelectField.astro";
import Many2OneField from "./Many2OneField.astro";

interface Props {
  node: FormNode;
}
const { node } = Astro.props;
---

{node.kind === "text" && <TextField label={node.label} value={node.value} editable={node.editable} name={node.key} />}
{node.kind === "select" && (
  <SelectField label={node.label} value={node.value} options={node.options} editable={node.editable} name={node.key} />
)}
{node.kind === "many2one" && <Many2OneField label={node.label} value={node.value} editable={node.editable} />}
