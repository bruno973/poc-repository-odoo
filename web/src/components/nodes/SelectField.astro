---
// components/nodes/SelectField.astro
interface Props {
  label: string;
  value: string | null;
  options: ReadonlyArray<{ value: string; label: string }>;
  editable: boolean;
  name?: string;
}
const { label, value, options, editable, name } = Astro.props;

const selectedOption = options.find((o) => o.value === value);
---

<div class="field field--select">
  <span class="field__label">{label}</span>
  {editable ? (
    <select class="field__select" name={name}>
      <option value="">—</option>
      {options.map((opt) => (
        <option value={opt.value} selected={opt.value === value}>
          {opt.label}
        </option>
      ))}
    </select>
  ) : (
    <span class="field__value">
      {selectedOption ? selectedOption.label : <em class="field__empty">—</em>}
    </span>
  )}
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 6px 0;
    border-bottom: 1px solid #f0f0f0;
  }
  .field__label {
    font-size: 0.75rem;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .field__value {
    font-size: 0.95rem;
    color: #222;
  }
  .field__empty {
    color: #ccc;
    font-style: normal;
  }
  .field__select {
    font-size: 0.95rem;
    color: #222;
    padding: 4px 8px;
    border: 1px solid #d0d4e8;
    border-radius: 4px;
    background: #fff;
    font-family: inherit;
  }
  .field__select:focus {
    outline: none;
    border-color: #4c6ef5;
  }
</style>
