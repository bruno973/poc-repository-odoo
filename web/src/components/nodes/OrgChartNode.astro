---
// components/nodes/OrgChartNode.astro
interface OrgChartNodeData {
  id: number;
  fullName: string;
  jobTitle: string | null;
  photo: string | null;
  children: OrgChartNodeData[];
}
interface Props {
  node: OrgChartNodeData;
  depth?: number;
}
const { node, depth = 0 } = Astro.props;
---

<div class={`org-node depth-${depth}`}>
  <a href={`/employees/${node.id}`} class="org-node__card">
    <div class="org-node__avatar">
      {node.photo
        ? <img src={node.photo} alt={node.fullName} width="40" height="40" />
        : <span class="org-node__initials">{node.fullName.charAt(0)}</span>
      }
    </div>
    <div class="org-node__info">
      <span class="org-node__name">{node.fullName}</span>
      {node.jobTitle && <span class="org-node__title">{node.jobTitle}</span>}
    </div>
  </a>

  {node.children.length > 0 && (
    <div class="org-node__children">
      {node.children.map((child) => (
        <Astro.self node={child} depth={depth + 1} />
      ))}
    </div>
  )}
</div>

<style>
  .org-node {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .org-node__card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border: 1px solid #dde;
    border-radius: 8px;
    text-decoration: none;
    background: #fff;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    transition: box-shadow 0.15s;
  }
  .org-node__card:hover {
    box-shadow: 0 2px 8px rgba(76, 110, 245, 0.18);
    border-color: #4c6ef5;
  }
  .org-node__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: #e8edff;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .org-node__initials {
    font-weight: 700;
    color: #4c6ef5;
    font-size: 1rem;
  }
  .org-node__info {
    display: flex;
    flex-direction: column;
  }
  .org-node__name {
    font-weight: 600;
    font-size: 0.9rem;
    color: #222;
  }
  .org-node__title {
    font-size: 0.78rem;
    color: #888;
  }
  .org-node__children {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 2px solid #e0e4f5;
    position: relative;
  }
  .depth-0 > .org-node__children::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: 1rem;
    background: #e0e4f5;
  }
</style>
