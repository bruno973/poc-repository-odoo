---
// pages/employees/[id].astro
// Fiche complète d'un employé avec onglets.

import type { EmployeeFormRecord } from "../../types/domain.js";
import TreeForm from "../../components/TreeForm.astro";
import OrgChartNode from "../../components/nodes/OrgChartNode.astro";
import AppNav from "../../components/AppNav.astro";
import { apiGet, ApiError } from "../../lib/api.js";

const { id } = Astro.params;
if (!id) return Astro.redirect("/employees");

let record: EmployeeFormRecord;
try {
  // L'API renvoie la fiche déjà élaguée pour le viewer (injecté par lib/viewer.ts).
  record = await apiGet<EmployeeFormRecord>(`/api/employees/${id}`);
} catch (error) {
  if (error instanceof ApiError && error.status === 404) return Astro.redirect("/employees");
  throw error;
}
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{record.headerSummary.fullName} — Fiche employé</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: system-ui, sans-serif; margin: 0; background: #f4f6fb; color: #222; }
    .page { max-width: 960px; margin: 0 auto; padding: 2rem 1rem; }

    .back-link {
      display: inline-flex; align-items: center; gap: 6px;
      color: #4c6ef5; text-decoration: none; font-size: 0.88rem;
      margin-bottom: 1.25rem;
    }
    .back-link:hover { text-decoration: underline; }

    .hero {
      background: #fff;
      border-radius: 12px;
      padding: 1.5rem;
      display: flex;
      align-items: center;
      gap: 1.25rem;
      box-shadow: 0 1px 6px rgba(0,0,0,0.07);
      margin-bottom: 1.5rem;
      border: 1px solid #eaecf5;
    }
    .hero__avatar {
      width: 72px; height: 72px;
      border-radius: 50%;
      background: #e8edff;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.8rem; font-weight: 700; color: #4c6ef5;
      overflow: hidden; flex-shrink: 0;
    }
    .hero__avatar img { width: 100%; height: 100%; object-fit: cover; }
    .hero__info { flex: 1; }
    .hero__name { font-size: 1.4rem; font-weight: 700; margin: 0 0 4px; }
    .hero__title { color: #888; font-size: 0.95rem; }
    .hero__dept {
      display: inline-block;
      margin-top: 8px;
      font-size: 0.8rem; padding: 2px 10px;
      border-radius: 12px; background: #e8edff; color: #4c6ef5; font-weight: 600;
    }
    .hero__email { margin-top: 6px; font-size: 0.85rem; color: #555; }

    .form-card {
      background: #fff;
      border-radius: 12px;
      padding: 1.5rem;
      box-shadow: 0 1px 6px rgba(0,0,0,0.07);
      border: 1px solid #eaecf5;
      margin-bottom: 1.5rem;
    }

    .orgchart-section {
      background: #fff;
      border-radius: 12px;
      padding: 1.5rem;
      box-shadow: 0 1px 6px rgba(0,0,0,0.07);
      border: 1px solid #eaecf5;
    }
    .orgchart-section h2 {
      font-size: 1rem; font-weight: 600; color: #555;
      margin: 0 0 1rem 0; text-transform: uppercase; letter-spacing: 0.06em;
    }
    .orgchart-wrapper {
      display: flex;
      justify-content: center;
      overflow-x: auto;
      padding: 1rem 0;
    }
  </style>
</head>
<body>
  <AppNav current="employees" />
  <div class="page">
    <a href="/employees" class="back-link">← Retour à l'annuaire</a>

    <!-- Hero header -->
    <div class="hero">
      <div class="hero__avatar">
        {record.headerSummary.photo
          ? <img src={record.headerSummary.photo} alt={record.headerSummary.fullName} />
          : record.headerSummary.fullName.charAt(0).toUpperCase()
        }
      </div>
      <div class="hero__info">
        <h1 class="hero__name">{record.headerSummary.fullName}</h1>
        {record.headerSummary.jobTitle && (
          <div class="hero__title">{record.headerSummary.jobTitle}</div>
        )}
        {record.headerSummary.department && (
          <span class="hero__dept">🏢 {record.headerSummary.department.label}</span>
        )}
        {record.headerSummary.workEmail && (
          <div class="hero__email">✉ {record.headerSummary.workEmail}</div>
        )}
      </div>
    </div>

    <!-- Fiche structurée (onglets) -->
    <div class="form-card">
      <TreeForm record={record} />
    </div>

    <!-- Organigramme -->
    {record.orgChart && (
      <div class="orgchart-section">
        <h2>🌳 Organigramme</h2>
        <div class="orgchart-wrapper">
          <OrgChartNode node={record.orgChart} />
        </div>
      </div>
    )}
  </div>
</body>
</html>
