---
// pages/synthese.astro — Synthèse des heures ventilées, en arbre dépliable.
// Le premier niveau est rendu côté serveur ; chaque dépliage appelle le port
// SummaryRepository via le proxy (un niveau = un appel = un read_group côté Odoo).
import Shell from "../components/Shell.astro";
import { apiGet, ApiError } from "../lib/api.js";
import { hm } from "../lib/format.js";
import type { HoursStatus, SummaryDimension, SummaryGroup, SummaryTotals } from "../types/domain.js";

const url = new URL(Astro.request.url);
const statusParam = url.searchParams.get("statut") ?? "approved";
const status = (["to_approve", "approved", "refused"] as const).find((s) => s === statusParam) as HoursStatus | undefined;
const withWeek = url.searchParams.get("semaine") === "1";
const withDay = url.searchParams.get("jour") === "1";

const dimensions: SummaryDimension[] = [
  "pole",
  "department",
  "employee",
  "period",
  ...(withWeek ? (["week"] as const) : []),
  ...(withDay ? (["weekday"] as const) : []),
];
const LABEL: Record<SummaryDimension, string> = {
  pole: "Pôle",
  department: "Service",
  employee: "Employé",
  period: "Période",
  week: "Semaine",
  weekday: "Jour",
};

const COLUMNS: { key: keyof SummaryTotals; label: string; hours: boolean }[] = [
  { key: "worked", label: "H. travaillées", hours: true },
  { key: "day", label: "H. jour", hours: true },
  { key: "night", label: "H. nuit", hours: true },
  { key: "overtime25", label: "H.S. 25 %", hours: true },
  { key: "overtime50", label: "H.S. 50 %", hours: true },
  { key: "sunday", label: "H. dimanche", hours: true },
  { key: "publicHoliday", label: "H. fériées", hours: true },
  { key: "meals", label: "Repas", hours: false },
  { key: "daysBreakArrival", label: "Jours arr. break", hours: false },
  { key: "daysTransportArrival", label: "Jours voy. arrivée", hours: false },
  { key: "daysBreakDeparture", label: "Jours dép. break", hours: false },
  { key: "daysTransportDeparture", label: "Jours voy. départ", hours: false },
];

let roots: SummaryGroup[] = [];
let error: string | null = null;
try {
  roots = await apiGet<SummaryGroup[]>("/api/summary/groups", {
    dimension: dimensions[0],
    path: "[]",
    status,
  });
} catch (e) {
  error = e instanceof ApiError ? e.message : "Erreur inattendue.";
}

const grand = Object.fromEntries(
  COLUMNS.map((c) => [c.key, roots.reduce((acc, g) => acc + (g.totals[c.key] ?? 0), 0)]),
) as Record<keyof SummaryTotals, number>;

const fmt = (c: (typeof COLUMNS)[number], v: number) => (c.hours ? hm(v) : String(v));
const toggleQuery = (name: string, on: boolean) => {
  const q = new URLSearchParams(url.searchParams);
  if (on) q.set(name, "1");
  else q.delete(name);
  return `?${q.toString()}`;
};
---

<Shell title="Synthèse" current="synthese">
  <div class="head">
    <h1>Synthèse</h1>
    <form method="get" class="toolbar">
      {withWeek && <input type="hidden" name="semaine" value="1" />}
      {withDay && <input type="hidden" name="jour" value="1" />}
      <select name="statut" aria-label="Statut des heures" onchange="this.form.submit()">
        <option value="approved" selected={statusParam === "approved"}>Heures approuvées</option>
        <option value="to_approve" selected={statusParam === "to_approve"}>Heures à approuver</option>
        <option value="refused" selected={statusParam === "refused"}>Heures refusées</option>
        <option value="tous" selected={statusParam === "tous"}>Tous les statuts</option>
      </select>
      <noscript><button class="btn">Filtrer</button></noscript>
    </form>
  </div>

  <p class="grouping">
    Regroupé par
    {dimensions.map((d, i) => (
      <>{i > 0 && <span class="sep">›</span>}<strong>{LABEL[d]}</strong></>
    ))}
    <a class="link" href={toggleQuery("semaine", !withWeek)}>{withWeek ? "Retirer" : "Ajouter"} la semaine</a>
    <a class="link" href={toggleQuery("jour", !withDay)}>{withDay ? "Retirer" : "Ajouter"} le jour</a>
  </p>

  {error && <p class="banner is-error">{error}</p>}
  <p class="banner is-error tree-error" hidden></p>

  <div class="card table-wrap">
    <table class="grid tree" data-dimensions={JSON.stringify(dimensions)} data-status={status ?? ""}>
      <thead>
        <tr>
          <th>{LABEL[dimensions[0] ?? "pole"]}</th>
          {COLUMNS.map((c) => <th class="is-num">{c.label.replace(" %", "\u00a0%")}</th>)}
        </tr>
      </thead>
      <tbody>
        {roots.map((g, i) => (
          <tr class="group depth-0" data-row={`r${i}`} data-ancestors="" data-depth="0" data-path={JSON.stringify([g.key])}>
            <td>
              <button type="button" class="toggle" aria-expanded="false" disabled={g.count === 0}>
                <span class="caret" aria-hidden="true">{g.count ? "▸" : ""}</span>{g.label}
                <span class="count num">({g.count})</span>
              </button>
            </td>
            {COLUMNS.map((c) => <td class="is-num num">{g.count ? fmt(c, g.totals[c.key]) : ""}</td>)}
          </tr>
        ))}
        {roots.length === 0 && !error && (
          <tr><td colspan={COLUMNS.length + 1} class="empty">Aucune heure avec ce statut. Choisis « Tous les statuts » pour tout afficher.</td></tr>
        )}
      </tbody>
      {roots.length > 0 && (
        <tfoot>
          <tr><th>Total</th>{COLUMNS.map((c) => <td class="is-num num">{fmt(c, grand[c.key])}</td>)}</tr>
        </tfoot>
      )}
    </table>
  </div>
  <template id="columns">{JSON.stringify(COLUMNS)}</template>
</Shell>

<style>
  .grouping { color: #6b7088; display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; margin: -0.25rem 0 1rem; }
  .grouping strong { color: #222; }
  .grouping .sep { color: #b6bbcc; }
  .grouping .link { margin-left: 0.5rem; font-size: 0.85rem; }
</style>

<style is:global>
  .tree .group td:first-child { font-weight: 600; }
  .tree .depth-0 { background: #fafbfe; }
  .tree .line td { font-size: 0.84rem; color: #4a4f63; }
  .tree .toggle { background: none; border: 0; padding: 0; font: inherit; font-weight: inherit; cursor: pointer; display: inline-flex; gap: 0.35rem; align-items: center; color: inherit; text-align: left; }
  .tree .toggle:disabled { cursor: default; color: #8a8fa3; }
  .tree .caret { width: 0.9rem; color: #4c6ef5; }
  .tree .count { font-size: 0.78rem; color: #8a8fa3; font-weight: 400; }
</style>

<script>
  import { fmtDateTime, hm } from "../lib/format.js";

  interface Key { dimension: string; value: number | string | null }
  interface Group { key: Key; label: string; count: number; totals: Record<string, number> }
  interface Line { id: number; checkIn: string; weekday: string; slot: string | null; totals: Record<string, number> }
  interface Column { key: string; label: string; hours: boolean }

  const table = document.querySelector<HTMLTableElement>("table.tree");
  const errorBox = document.querySelector<HTMLElement>(".tree-error");
  const columns: Column[] = JSON.parse(document.getElementById("columns")?.innerHTML ?? "[]");
  const dimensions: string[] = JSON.parse(table?.dataset.dimensions ?? "[]");
  const status = table?.dataset.status ?? "";
  let seq = 0;

  const cell = (text: string, cls = "is-num num") => {
    const td = document.createElement("td");
    td.className = cls;
    td.textContent = text;
    return td;
  };
  const fmt = (c: Column, v: number | undefined) => (c.hours ? hm(v ?? 0) : String(v ?? 0));

  async function load(row: HTMLTableRowElement) {
    const path: Key[] = JSON.parse(row.dataset.path ?? "[]");
    const depth = Number(row.dataset.depth) + 1;
    const next = dimensions[depth];
    const q = new URLSearchParams({ path: JSON.stringify(path) });
    if (status) q.set("status", status);
    if (next) q.set("dimension", next);
    const res = await fetch(`/api/summary/${next ? "groups" : "lines"}?${q}`);
    const data = await res.json();
    document.dispatchEvent(new Event("leila:api-call"));
    if (!res.ok) throw new Error(data.message ?? `Erreur ${res.status}`);

    const ancestors = `${row.dataset.ancestors ?? ""} ${row.dataset.row}`.trim();
    const indent = `${0.6 + depth * 1.2}rem`;
    const rows: HTMLTableRowElement[] = [];

    if (next) {
      for (const g of data as Group[]) {
        const tr = document.createElement("tr");
        tr.className = `group depth-${Math.min(depth, 4)}`;
        tr.dataset.row = `r${++seq}-${depth}`;
        tr.dataset.ancestors = ancestors;
        tr.dataset.depth = String(depth);
        tr.dataset.path = JSON.stringify([...path, g.key]);
        const td = document.createElement("td");
        td.style.paddingLeft = indent;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "toggle";
        btn.setAttribute("aria-expanded", "false");
        btn.disabled = g.count === 0;
        btn.innerHTML = `<span class="caret" aria-hidden="true">${g.count ? "▸" : ""}</span>`;
        btn.append(g.label);
        const count = document.createElement("span");
        count.className = "count num";
        count.textContent = `(${g.count})`;
        btn.append(count);
        td.append(btn);
        tr.append(td, ...columns.map((c) => cell(g.count ? fmt(c, g.totals[c.key]) : "")));
        rows.push(tr);
      }
    } else {
      for (const l of data as Line[]) {
        const tr = document.createElement("tr");
        tr.className = "line";
        tr.dataset.ancestors = ancestors;
        const td = cell(`${l.weekday} ${fmtDateTime(l.checkIn)}${l.slot ? `  ·  ${l.slot}` : ""}`, "num");
        td.style.paddingLeft = indent;
        tr.append(td, ...columns.map((c) => cell(l.totals[c.key] ? fmt(c, l.totals[c.key]) : "")));
        rows.push(tr);
      }
    }
    row.after(...rows);
  }

  table?.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button.toggle");
    const row = button?.closest<HTMLTableRowElement>("tr");
    if (!button || !row || button.disabled) return;
    const caret = button.querySelector(".caret");
    if (button.getAttribute("aria-expanded") === "true") {
      table.querySelectorAll(`tr[data-ancestors~="${row.dataset.row}"]`).forEach((r) => r.remove());
      button.setAttribute("aria-expanded", "false");
      if (caret) caret.textContent = "▸";
      return;
    }
    button.disabled = true;
    try {
      await load(row);
      button.setAttribute("aria-expanded", "true");
      if (caret) caret.textContent = "▾";
      if (errorBox) errorBox.hidden = true;
    } catch (e) {
      if (errorBox) {
        errorBox.textContent = (e as Error).message;
        errorBox.hidden = false;
      }
    } finally {
      button.disabled = false;
    }
  });
</script>
