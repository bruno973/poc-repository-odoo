---
// pages/pointer.astro — Pointer une arrivée ou un départ.
// Rendu serveur de l'état, action par fetch vers le proxy /api/*, puis rechargement.
import Shell from "../components/Shell.astro";
import { apiGet, ApiError, isUnauthenticated, loginUrl } from "../lib/api.js";
import { currentViewer } from "../lib/viewer.js";
import { duration, fmtDateTime, fmtTime, hm } from "../lib/format.js";
import type { Attendance, AttendancePage, EmployeeListResult } from "../types/domain.js";

const viewer = currentViewer(Astro.locals);
const url = new URL(Astro.request.url);
const ok = url.searchParams.get("ok");

let error: string | null = null;
let employees: EmployeeListResult["items"] = [];
let open: Attendance | null = null;
let recent: Attendance[] = [];
let employeeId: number | undefined;

try {
  employees = (await apiGet<EmployeeListResult>(Astro, "/api/employees", { limit: 200 })).items;
  const wanted = Number(url.searchParams.get("employe")) || viewer.employeeId;
  employeeId = employees.find((e) => e.id === wanted)?.id ?? employees[0]?.id;
  if (employeeId !== undefined) {
    const [current, page] = await Promise.all([
      apiGet<{ attendance: Attendance | null }>(Astro, `/api/employees/${employeeId}/open-attendance`),
      apiGet<AttendancePage>(Astro, "/api/attendances", { employeeId, limit: 6 }),
    ]);
    open = current.attendance;
    recent = page.items;
  }
} catch (e) {
  if (isUnauthenticated(e)) return Astro.redirect(loginUrl(Astro.url));
  error = e instanceof ApiError ? e.message : "Erreur inattendue.";
}

const now = new Date();
---

<Shell title="Pointer" current="pointer">
  <div class="head">
    <h1>Pointer</h1>
    <form method="get" class="toolbar">
      <label class="muted" for="employe">Pointer pour</label>
      <select id="employe" name="employe" onchange="this.form.submit()">
        {employees.map((e) => <option value={e.id} selected={e.id === employeeId}>{e.fullName}</option>)}
      </select>
      <noscript><button class="btn">Afficher</button></noscript>
    </form>
  </div>

  {error && <p class="banner is-error">{error}</p>}
  {ok && <p class="banner is-ok">{ok}</p>}

  {employeeId !== undefined && (
    <section class="card punch-card" data-employee-id={employeeId} data-mode={open ? "out" : "in"}>
      <p class="clock num" aria-live="off">{fmtTime(now.toISOString())}</p>
      <p class={`state ${open ? "is-in" : ""}`}>
        {open ? `Présent depuis ${fmtTime(open.checkIn)}, soit ${duration(open.checkIn, now)}` : "Pas d'arrivée en cours"}
      </p>

      <fieldset class="options">
        <legend>{open ? "Au départ" : "À l'arrivée"}</legend>
        {open ? (
          <>
            <label class="check"><input type="checkbox" name="breakDeparture" /> Je pars en break</label>
            <label class="check"><input type="checkbox" name="transportDeparture" /> Je repars en transport</label>
            <label class="check">Repas pris sur place
              <select name="meals">
                <option value="0">0</option><option value="1">1</option><option value="2">2</option><option value="3">3</option>
              </select>
            </label>
          </>
        ) : (
          <>
            <label class="check"><input type="checkbox" name="breakArrival" /> Je reviens de break</label>
            <label class="check"><input type="checkbox" name="transportArrival" /> J'arrive en transport</label>
          </>
        )}
      </fieldset>

      <button type="button" class="btn punch">{open ? "Pointer le départ" : "Pointer l'arrivée"}</button>
      <p class="banner is-error punch-error" hidden></p>
    </section>
  )}

  <section class="card recent">
    <h2>Derniers pointages</h2>
    {recent.length === 0 ? (
      <p class="muted">Aucun pointage enregistré pour cet employé.</p>
    ) : (
      <table class="grid">
        <thead><tr><th>Arrivée</th><th>Départ</th><th class="is-num">Temps</th></tr></thead>
        <tbody>
          {recent.map((a) => (
            <tr>
              <td class="num">{fmtDateTime(a.checkIn)}</td>
              <td class="num">{a.checkOut ? fmtDateTime(a.checkOut) : <span class="muted">en cours</span>}</td>
              <td class="is-num num">{a.checkOut ? hm(a.workedHours) : ""}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </section>
</Shell>

<style>
  .punch-card { padding: 1.5rem 1.75rem; max-width: 720px; margin-bottom: 1.25rem; }
  .clock { font-size: clamp(3.5rem, 11vw, 6rem); font-weight: 700; line-height: 1; margin: 0 0 0.5rem; color: #364fc7; letter-spacing: -0.03em; }
  .state { margin: 0 0 1.25rem; font-weight: 600; color: #8a8fa3; }
  .state.is-in { color: #2b8a3e; }
  .options { border: 0; border-top: 1px solid #eaecf5; padding: 1rem 0 0; margin: 0 0 1.25rem; display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; }
  .options legend { color: #8a8fa3; font-size: 0.85rem; padding-right: 0.5rem; }
  .punch { width: 100%; height: 56px; font-size: 1.05rem; }
  .punch-error { margin-top: 1rem; }
  .recent { padding: 1rem 1.25rem; max-width: 720px; }
  .recent h2 { font-size: 1rem; margin: 0 0 0.5rem; }
</style>

<script>
  import { fmtTime } from "../lib/format.js";

  const card = document.querySelector<HTMLElement>(".punch-card");
  const clock = document.querySelector<HTMLElement>(".clock");
  setInterval(() => {
    if (clock) clock.textContent = fmtTime(new Date().toISOString());
  }, 1000);

  const button = card?.querySelector<HTMLButtonElement>(".punch");
  const errorBox = card?.querySelector<HTMLElement>(".punch-error");

  button?.addEventListener("click", async () => {
    if (!card || !button || !errorBox) return;
    const id = card.dataset.employeeId;
    const mode = card.dataset.mode;
    const movements: Record<string, boolean | number> = {};
    card.querySelectorAll<HTMLInputElement>("input[type=checkbox]").forEach((i) => (movements[i.name] = i.checked));
    const meals = card.querySelector<HTMLSelectElement>("select[name=meals]");
    if (meals) movements["meals"] = Number(meals.value);

    button.disabled = true;
    errorBox.hidden = true;
    try {
      const res = await fetch(`/api/employees/${id}/check-${mode}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ movements }),
      });
      if (res.status === 401) {
        location.href = `/login?retour=${encodeURIComponent(location.pathname + location.search)}`;
        return;
      }
      const data = await res.json();
      document.dispatchEvent(new Event("leila:api-call"));
      if (!res.ok) throw new Error(data.message ?? `Erreur ${res.status}`);
      const message =
        mode === "in" ? `Arrivée enregistrée à ${fmtTime(data.checkIn)}.` : `Départ enregistré à ${fmtTime(data.checkOut)}.`;
      location.href = `/pointer?employe=${id}&ok=${encodeURIComponent(message)}`;
    } catch (e) {
      errorBox.textContent = (e as Error).message;
      errorBox.hidden = false;
      button.disabled = false;
    }
  });
</script>
