---
// pages/gestion.astro — Liste des pointages, correction des mouvements, approbation.
// Filtres et pagination en rendu serveur ; actions par fetch vers le proxy /api/*.
import Shell from "../components/Shell.astro";
import { apiGet, ApiError } from "../lib/api.js";
import { STATUS_LABEL, fmtDateTime, hm } from "../lib/format.js";
import type { AttendancePage, HoursStatus } from "../types/domain.js";

const PAGE = 80;
const url = new URL(Astro.request.url);
const employeeId = Number(url.searchParams.get("employe")) || undefined;
const withWorked = url.searchParams.get("heures") !== "0";
const statusParam = url.searchParams.get("statut") ?? "";
const status = (["to_approve", "approved", "refused"] as const).find((s) => s === statusParam) as HoursStatus | undefined;
const offset = Math.max(0, Number(url.searchParams.get("offset")) || 0);

let page: AttendancePage = { items: [], total: 0 };
let error: string | null = null;
try {
  page = await apiGet<AttendancePage>("/api/attendances", {
    employeeId,
    withWorkedHours: withWorked ? "1" : undefined,
    status,
    limit: PAGE,
    offset,
  });
} catch (e) {
  error = e instanceof ApiError ? e.message : "Erreur inattendue.";
}

const link = (o: number) => {
  const q = new URLSearchParams(url.searchParams);
  q.set("offset", String(o));
  return `?${q.toString()}`;
};

const MOVES = [
  { key: "breakArrival", label: "Arrivée de break" },
  { key: "breakDeparture", label: "Part en break" },
  { key: "transportArrival", label: "Arrivé en transport" },
  { key: "transportDeparture", label: "Départ en transport" },
] as const;
---

<Shell title="Gestion" current="gestion">
  <div class="head">
    <h1>Gestion</h1>
    <form method="get" class="toolbar filters">
      {employeeId && <a class="link" href="/gestion">Tous les employés ✕</a>}
      {employeeId && <input type="hidden" name="employe" value={employeeId} />}
      <label class="check"><input type="checkbox" name="heures" value="1" checked={withWorked} /> Avec heures travaillées</label>
      <!-- Après la case : quand elle est cochée, "1" arrive en premier et l'emporte -->
      <input type="hidden" name="heures" value="0" />
      <select name="statut" aria-label="Statut des heures">
        <option value="">Tous les statuts</option>
        <option value="to_approve" selected={status === "to_approve"}>À approuver</option>
        <option value="approved" selected={status === "approved"}>Approuvé</option>
        <option value="refused" selected={status === "refused"}>Refusé</option>
      </select>
      <noscript><button class="btn">Filtrer</button></noscript>
      <span class="muted num pager">
        {page.total === 0 ? 0 : offset + 1}–{Math.min(offset + PAGE, page.total)} sur {page.total}
        {offset > 0 && <a class="link" href={link(Math.max(0, offset - PAGE))} aria-label="Page précédente">‹</a>}
        {offset + PAGE < page.total && <a class="link" href={link(offset + PAGE)} aria-label="Page suivante">›</a>}
      </span>
    </form>
  </div>

  {error && <p class="banner is-error">{error}</p>}
  <p class="banner is-error action-error" hidden></p>

  <div class="card table-wrap">
    <table class="grid">
      <thead>
        <tr>
          <th>Employé</th><th>Arrivée</th><th>Départ</th><th class="is-num">Repas</th>
          {MOVES.map((m) => <th class="is-center">{m.label}</th>)}
          <th class="is-num">Temps de travail</th><th>Statut des heures</th><th></th>
        </tr>
      </thead>
      <tbody>
        {page.items.map((a) => (
          <tr data-id={a.id}>
            <td><a class="who" href={`/gestion?employe=${a.employee.id}`}>{a.employee.label}</a></td>
            <td class="num">{fmtDateTime(a.checkIn)}</td>
            <td class="num">{a.checkOut ? fmtDateTime(a.checkOut) : <span class="muted">en cours</span>}</td>
            <td class="is-num num" data-cell="meals">{a.movements.meals}</td>
            {MOVES.map((m) => (
              <td class="is-center">
                <input type="checkbox" class="switch" data-key={m.key} checked={a.movements[m.key]}
                  aria-label={`${m.label}, ${a.employee.label}, ${fmtDateTime(a.checkIn)}`} />
              </td>
            ))}
            <td class="is-num num" data-cell="worked">{hm(a.workedHours)}</td>
            <td data-cell="status">{a.hoursStatus && <span class={`status is-${a.hoursStatus}`}>{STATUS_LABEL[a.hoursStatus]}</span>}</td>
            <td class="actions">
              <button type="button" class="link" data-action="approve" hidden={a.hoursStatus === "approved"}>Approuver</button>
              <button type="button" class="link is-danger" data-action="refuse" hidden={a.hoursStatus === "refused"}>Refuser</button>
            </td>
          </tr>
        ))}
        {page.items.length === 0 && !error && (
          <tr><td colspan="11" class="empty">Aucun pointage avec ces filtres. Décoche « Avec heures travaillées » ou change de statut.</td></tr>
        )}
      </tbody>
    </table>
  </div>
</Shell>

<style>
  .pager { display: inline-flex; gap: 0.35rem; align-items: center; margin-left: 0.5rem; }
  .who { color: #222; text-decoration: none; font-weight: 500; }
  .who:hover { color: #4c6ef5; text-decoration: underline; }
  .grid thead th.is-center { width: 84px; }
  .actions { text-align: right; white-space: normal !important; }
  .actions .link { display: block; margin-left: auto; }
</style>

<script>
  import { STATUS_LABEL, hm } from "../lib/format.js";

  interface Attendance {
    id: number;
    workedHours: number;
    movements: Record<string, boolean | number>;
    hoursStatus: "to_approve" | "approved" | "refused" | null;
  }

  // Filtres : soumission automatique
  const filters = document.querySelector<HTMLFormElement>("form.filters");
  filters?.querySelectorAll("input[type=checkbox], select").forEach((el) =>
    el.addEventListener("change", () => filters.submit()),
  );

  const errorBox = document.querySelector<HTMLElement>(".action-error");

  function render(row: HTMLElement, a: Attendance) {
    row.querySelector('[data-cell="worked"]')!.textContent = hm(a.workedHours);
    row.querySelector('[data-cell="meals"]')!.textContent = String(a.movements["meals"] ?? 0);
    const statusCell = row.querySelector('[data-cell="status"]')!;
    statusCell.replaceChildren();
    if (a.hoursStatus) {
      const badge = document.createElement("span");
      badge.className = `status is-${a.hoursStatus}`;
      badge.textContent = STATUS_LABEL[a.hoursStatus] ?? a.hoursStatus;
      statusCell.append(badge);
    }
    row.querySelectorAll<HTMLInputElement>("input.switch").forEach((i) => {
      i.checked = Boolean(a.movements[i.dataset.key ?? ""]);
    });
    row.querySelector<HTMLElement>('[data-action="approve"]')!.hidden = a.hoursStatus === "approved";
    row.querySelector<HTMLElement>('[data-action="refuse"]')!.hidden = a.hoursStatus === "refused";
  }

  async function act(row: HTMLElement, request: () => Promise<Response>, rollback?: () => void) {
    row.classList.add("is-pending");
    if (errorBox) errorBox.hidden = true;
    try {
      const res = await request();
      const data = await res.json();
      document.dispatchEvent(new Event("leila:api-call"));
      if (!res.ok) throw new Error(data.message ?? `Erreur ${res.status}`);
      render(row, data as Attendance);
    } catch (e) {
      rollback?.();
      if (errorBox) {
        errorBox.textContent = (e as Error).message;
        errorBox.hidden = false;
      }
    } finally {
      row.classList.remove("is-pending");
    }
  }

  document.querySelectorAll<HTMLElement>("tr[data-id]").forEach((row) => {
    const id = row.dataset.id;
    row.querySelectorAll<HTMLInputElement>("input.switch").forEach((input) =>
      input.addEventListener("change", () => {
        const checked = input.checked;
        void act(
          row,
          () =>
            fetch(`/api/attendances/${id}`, {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ movements: { [input.dataset.key ?? ""]: checked } }),
            }),
          () => (input.checked = !checked),
        );
      }),
    );
    row.querySelectorAll<HTMLButtonElement>("[data-action]").forEach((button) =>
      button.addEventListener("click", () =>
        act(row, () => fetch(`/api/attendances/${id}/${button.dataset.action}`, { method: "POST" })),
      ),
    );
  });
</script>
