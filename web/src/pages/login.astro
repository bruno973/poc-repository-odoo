---
// pages/login.astro — Connexion avec les identifiants Odoo (identité réelle).
// Le formulaire est traité ICI, côté serveur : le mot de passe va du navigateur au
// serveur Astro, puis à l'API, qui le passe à Odoo et l'oublie. Le cookie de
// session posé par l'API est relayé au navigateur.
import { API_BASE, safeReturn } from "../lib/api.js";

const retour = safeReturn(Astro.url.searchParams.get("retour"));
if (Astro.locals.auth.mode === "shared") return Astro.redirect(retour);

let error: string | null = null;
let login = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  login = String(form.get("login") ?? "");
  const password = String(form.get("password") ?? "");
  try {
    const res = await fetch(`${API_BASE}/api/auth/login`, {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-Forwarded-For": Astro.clientAddress },
      body: JSON.stringify({ login, password }),
    });
    if (res.status === 204) {
      const headers = new Headers({ Location: retour });
      for (const c of res.headers.getSetCookie()) headers.append("Set-Cookie", c);
      return new Response(null, { status: 303, headers });
    }
    error =
      res.status === 429
        ? "Trop de tentatives : réessaie dans une minute."
        : res.status === 401
          ? "Identifiant ou mot de passe incorrect."
          : "Connexion impossible pour le moment.";
  } catch {
    error = "Connexion impossible pour le moment.";
  }
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connexion · Leila RH</title>
  </head>
  <body>
    <main class="login">
      <form method="post" class="card">
        <h1>Leila RH</h1>
        <p class="muted">Connecte-toi avec ton identifiant et ton mot de passe Odoo.</p>
        {error && <p class="banner" role="alert">{error}</p>}
        <label>Identifiant<input name="login" autocomplete="username" required value={login} autofocus={!login} /></label>
        <label>Mot de passe<input name="password" type="password" autocomplete="current-password" required autofocus={Boolean(login)} /></label>
        <button class="btn" type="submit">Se connecter</button>
      </form>
    </main>
  </body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; }
  body { font-family: system-ui, sans-serif; margin: 0; background: #f4f6fb; color: #222; }
  .login { min-height: 100vh; display: grid; place-items: center; padding: 1rem; }
  .card { width: min(380px, 100%); background: #fff; border: 1px solid #eaecf5; border-radius: 12px; box-shadow: 0 1px 6px rgba(0,0,0,.05); padding: 1.75rem; display: flex; flex-direction: column; gap: 0.9rem; }
  h1 { margin: 0; font-size: 1.4rem; }
  .muted { margin: 0; color: #8a8fa3; font-size: 0.92rem; }
  label { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.85rem; color: #555; font-weight: 600; }
  input { height: 40px; border: 1px solid #dfe3f0; border-radius: 8px; padding: 0 0.7rem; font: inherit; font-weight: 400; }
  input:focus-visible { outline: 2px solid #4c6ef5; outline-offset: 1px; }
  .btn { height: 42px; border-radius: 8px; border: 0; background: #4c6ef5; color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
  .btn:hover { background: #3b5bdb; }
  .banner { margin: 0; padding: 0.6rem 0.8rem; border-radius: 8px; background: #fff0f0; color: #c92a2a; }
</style>
