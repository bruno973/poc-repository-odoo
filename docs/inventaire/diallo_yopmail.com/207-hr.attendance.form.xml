<form string="Pointages des employés" duplicate="false">
                <header>
                    <field name="overtime_status" widget="statusbar" invisible="no_validated_overtime_hours" readonly="0" options="{'clickable': '1'}" on_change="1"/>
                    <field name="overtime_status" widget="statusbar" invisible="not no_validated_overtime_hours" statusbar_visible="approved,refused" readonly="0" options="{'clickable': '1'}" on_change="1"/>
                </header>
                <sheet>
                    <group>
                        <group colspan="2">
                            <group col="1">
                                <field name="employee_id" widget="many2one_avatar_user" on_change="1" can_create="False" can_write="False"/>
                                <field name="check_in" options="{'rounding': 0}" on_change="1"/>
                                <field name="check_out" options="{'rounding': 0}" placeholder="Actuellement en train de travailler" on_change="1"/>
                            </group>
                            <group col="2">
                                <group string="Heures supplémentaires" col="12">
            <div class="d-flex" style="gap: 2rem; align-items: center; font-size: 14px;">
              <div>
                <span class="o_form_label" style="font-weight:600;">H.S.25%</span><br/>
                <field name="overtime_hours_t1" widget="float_time" string="H.S.25%" nolabel="1" readonly="1" class="oe_inline" style="min-width:6rem; text-align:center;"/>
              </div>

              <div>
                <span class="o_form_label" style="font-weight:600;">H.S.50%</span><br/>
                <field name="overtime_hours_t2" widget="float_time" string="H.S.50%" nolabel="1" readonly="1" class="oe_inline" style="min-width:6rem; text-align:center;"/>
              </div>

              <div>
                <span class="o_form_label" style="font-weight:600;">Total</span><br/>
                <field name="overtime_hours_total" widget="float_time" nolabel="1" readonly="1" class="oe_inline" style="min-width:6rem; text-align:center; font-weight:600;"/>
              </div>
            </div>
          </group>
        <div class="o_row">
                                <button class="oe_stat_button" string="Approuver" invisible="overtime_status not in ['to_approve', 'refused'] or no_validated_overtime_hours" name="action_approve_overtime" icon="fa-check" type="object"/>
                                    <button class="oe_stat_button" string="Refuser" invisible="overtime_status not in ['to_approve', 'approved'] or no_validated_overtime_hours" name="action_refuse_overtime" icon="fa-times" type="object"/>
                                </div>
                            </group>
                        </group>
                        <separator string="Arrivée"/>
                        <group name="check_in_group" colspan="2">
                            <group>
                                <group>
                                    <field name="in_mode"/>
                                    <field name="in_ip_address" invisible="in_mode == 'manual'"/>
                                    <field name="in_browser" invisible="in_mode == 'manual'"/>
                                </group>
                            </group>
                            <group invisible="in_mode == 'manual'">
                                <label for="in_country_name" string="Localisation"/>
                                <div class="o_row" name="in_location_info">
                                    <span>
                                        <field name="in_country_name"/>
                                    </span>
                                    <span>
                                        <field name="in_city" invisible="in_city == 'Unknown'" nolabel="1"/>
                                    </span>
                                </div>

                                <label for="in_latitude" string="Coordonnées GPS"/>
                                <div>
                                    <div class="o_row">
                                        <span>
                                            <field name="in_latitude"/>
                                        </span>,
                                        <span>
                                            <field name="in_longitude" nolabel="1"/>
                                        </span>
                                    </div>
                                    <button name="action_in_attendance_maps" type="object" class="btn btn-link ps-0 pt-0 pb-2" icon="oi-arrow-right" string="Voir dans Maps" colspan="2"/>
                                </div>
                            </group>
                        </group>
                        <separator string="Départ" name="check_out_separator" invisible="not check_out"/>
                        <group colspan="2" name="check_out_group" invisible="not check_out">
                            <group>
                                <group>
                                    <field name="out_mode" string="Mode"/>
                                    <field name="out_ip_address" string="Adresse IP" invisible="in_mode == 'manual'"/>
                                    <field name="out_browser" string="Navigateur" invisible="in_mode == 'manual'"/>
                                </group>
                            </group>
                            <group invisible="out_mode == 'manual'">
                                <label for="out_country_name" string="Localisation"/>
                                <div class="o_row" name="out_location_info">
                                    <span>
                                        <field name="out_country_name"/>
                                    </span>
                                    <span>
                                        <field name="out_city" invisible="out_city == 'Unknown'" nolabel="1"/>
                                    </span>
                                </div>

                                <label for="out_latitude" string="Coordonnées GPS"/>
                                <div>
                                    <div class="o_row">
                                        <span>
                                            <field name="out_latitude"/>
                                        </span>,
                                        <span>
                                            <field name="out_longitude" nolabel="1"/>
                                        </span>
                                    </div>
                                    <button name="action_out_attendance_maps" type="object" class="btn btn-link ps-0 pt-0 pb-2" icon="oi-arrow-right" string="Voir dans Maps" colspan="2"/>
                                </div>
                            </group>
                        </group>
                    </group>
          <group string="Mouvements liés">
            <group>
              <field name="break_entry" widget="boolean_toggle" string="Arrivé de break"/>
              <field name="break_exit" widget="boolean_toggle" string="Part en break"/>
              <field name="hide_meal_question" invisible="1"/>
              <field name="meal_count" string="Repas sur place" invisible="hide_meal_question"/>
            </group>
            <group>
              <field name="boat_arrival" widget="boolean_toggle" string="Arrivé en transport"/>
              <field name="boat_departure" widget="boolean_toggle" string="Départ en transport"/>
            </group>
          </group>
                </sheet>
                <chatter/>
            <field name="no_validated_overtime_hours" invisible="True" readonly="True" data-used-by="invisible=&quot;overtime_status not in ['to_approve', 'approved'] or no_validated_overtime_hours&quot; (button,action_refuse_overtime)"/>
</form>