<search string="Recherche sur les temps de présences">
                <field name="employee_id"/>
                <field name="department_id" operator="child_of"/>
                <field name="check_in"/>
                <filter string="Mes présences" name="myattendances" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter string="Mon équipe" name="myteam" domain="[('employee_id.parent_id.user_id', '=', uid)]"/>
                <separator/>
                <filter string="Au travail" name="nocheckout" domain="[('check_out', '=', False)]"/>
                <filter string="Erreurs" name="errors" domain="['|', ('worked_hours', '&gt;=', 16), '&amp;', ('check_out', '=', False), ('check_in', '&lt;=',  (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Checkout automatique" name="auto_check" domain="[('out_mode', '=', 'auto_check_out')]"/>
                <separator/>
                <filter string="Date" name="check_in_filter" date="check_in"/>
                <separator/>
                <filter string="Employés actifs" name="activeemployees" domain="[('employee_id.active', '=', True)]"/>
                <filter string="Employés archivés" name="archivedemployees" domain="[('employee_id.active', '=', False)]"/>
                <separator invisible="1"/>
                <filter string="Les 3 derniers mois" invisible="1" name="last_three_months" domain="[(                     'check_in','&gt;=', (                         context_today() + datetime.timedelta(days=-90)                         )                     )]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Employé" name="employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Département" name="departement" context="{'group_by': 'department_id'}"/>
                    <filter string="Manager" name="manager" context="{'group_by': 'manager_id'}"/>
                    <filter string="Mode" name="groupby_mode_in" context="{'group_by': 'in_mode'}"/>
                    <filter string="Date" name="groupby_name" context="{'group_by': 'check_in:month'}"/>
                </group>
            </search>