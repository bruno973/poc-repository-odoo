<form string="Employé" create="0" write="0" js_class="hr_employee_form" delete="False" edit="False">
                    <field name="image_128" invisible="1"/>
                    <header/>
                    <sheet>
                        <field name="user_id" invisible="1" on_change="1"/>
                        <field name="user_partner_id" invisible="1"/>
                        <field name="active" invisible="1"/>
                        <div class="oe_button_box" name="button_box">
                            <!-- Used by other modules-->
                <field name="show_leaves" invisible="1"/>
                <field name="is_absent" invisible="1"/>
                <button disabled="1" class="oe_stat_button" invisible="not is_absent">
                        <div role="img" invisible="hr_icon_display != 'presence_holiday_present'" class="fa fa-fw fa-plane o_button_icon text-success" aria-label="De retour le" title="De retour le"/>
                        <div invisible="hr_icon_display != 'presence_holiday_absent'" role="img" class="fa fa-fw fa-plane o_button_icon text-warning" aria-label="De retour le" title="De retour le"/>
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">
                            De retour le
                        </span>
                        <span class="o_stat_value">
                            <field name="leave_date_to"/>
                        </span>
                    </div>
                </button>
                        </div>
                        <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                        <div class="row justify-content-between position-relative w-100 m-0 mb-2">
                            <div class="oe_title ps-0 pe-2">
                                <label for="name" string="Nom de l'employé"/>
                                <h1 class="d-flex flex-row">
                                    <span class="me-2" invisible="not context.get('chat_icon')">
                                        <widget name="hr_employee_chat"/>
                                    </span>
                                    <field name="name" placeholder="par ex. John Doe" required="True" style="font-size: min(4vw, 2.6rem);"/>
                                </h1>
                                <h2>
                                    <field name="job_title" placeholder="Titre du poste"/>
                                </h2>
                            </div>
                            <div class="o_employee_avatar m-0 p-0">
                                <field name="avatar_1920" widget="image" class="oe_avatar" options="{&quot;zoom&quot;: true, &quot;preview_image&quot;:&quot;avatar_128&quot;}"/>
                                <field name="show_hr_icon_display" invisible="1"/>
                                <field name="hr_icon_display" class="d-flex align-items-end fs-6 o_employee_availability" invisible="not show_hr_icon_display or not id" widget="hr_presence_status"/>
                            </div>
                        </div>
                        <group>
                            <group>
                                <field name="mobile_phone" widget="phone"/>
                                <field name="work_phone" widget="phone"/>
                                <field name="work_email" widget="email"/>
                <field name="is_manager" invisible="1"/>
                <field name="first_contract_date" invisible="not is_manager"/>
                            </group>
                            <group>
                                <field name="department_id" context="{'open_employees_kanban': 1}" on_change="1"/>
                                <field name="job_id" on_change="1"/>
                                
                                <field name="parent_id" widget="many2one_avatar_user" on_change="1"/>
                                <field name="coach_id" widget="many2one_avatar_user"/>
                <field name="company_id" invisible="1" on_change="1"/>
                <field name="leave_manager_id" widget="many2one_avatar_user" can_create="False" can_write="False"/>
                            </group>
                        </group>
                        <notebook>
                <page name="skills_resume" string="CV">
                    <div class="row">
                        <div class="o_hr_skills_group o_group_resume col-lg-6 d-flex flex-column">
                            <!-- This field uses a custom list view rendered by the 'resume_one2many' widget.
                                Adding fields in the list arch below makes them accessible to the widget
                            -->
                            <field mode="list" nolabel="1" name="resume_line_ids" widget="resume_one2many">
                                <list>
                                    <field name="line_type_id"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="display_type" column_invisible="True"/>
                                </list>
                            </field>
                        </div>
                        <div class="o_hr_skills_group o_group_skills col-lg-5 d-flex flex-column">
                            <field name="employee_id" invisible="1" on_change="1"/>
                            <field mode="list" nolabel="1" name="employee_skill_ids" invisible="not employee_skill_ids" widget="skills_one2many">
                                <list>
                                    <field name="skill_type_id" optional="hidden" on_change="1"/>
                                    <field name="skill_id" on_change="1"/>
                                    <field name="skill_level_id" on_change="1"/>
                                    <field name="level_progress" widget="progressbar"/>
                                </list>
                            </field>
                        </div>
                    </div>
                </page>
                            <page name="public" string="Informations professionnelles">
                                <div id="o_work_employee_container" class="d-lg-flex"> <!-- These two div are used to position org_chart -->
                                    <div id="o_work_employee_main" class="flex-grow-1">
                                        <group string="Lieu" name="location">
                                            <field name="address_id" context="{'show_address': 1}" options="{&quot;highlight_first_line&quot;: True}" on_change="1"/>
                                            <field name="work_location_id"/>
                                        </group>
                                        <group name="managers" string="Validateurs" invisible="1">
                                            <!-- overridden in other modules -->
                                        </group>
                                    </div>
                <div id="o_employee_right" class="col-lg-4 px-0 ps-lg-5">
                    <separator string="Organigramme"/>
                    <field name="child_ids" class="position-relative" widget="hr_org_chart" readonly="1" nolabel="1"/>
                </div>
                                </div>
                            </page>
                <page string="Badges attribués" name="received_badges" invisible="not user_id">
                    <field name="has_badges" invisible="1"/>
                    <button string="Attribuer un badge" type="action" name="367"/> récompenser un employé pour une action positive
                    <div class="o_field_nocontent" invisible="has_badges">
                        <p>
                            Accordez son premier badge à cet employé
                        </p><p class="oe_grey">
                            Les badges sont une reconnaissance du bon travail. Donnez-les aux personnes que les méritent selon vous.
                        </p>
                    </div>
                    <field name="badge_ids" mode="kanban" widget="many2many"/>
                </page>
                        </notebook>
                    </sheet>
                </form>