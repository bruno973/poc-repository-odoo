<form string="Badge">
                <header>
                    <button string="Délivrer ce badge" type="action" name="282" class="oe_highlight" invisible="remaining_sending == 0"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    <button class="oe_stat_button" type="object" name="get_granted_employees" invisible="granted_count == 0" icon="fa-user">
                        <field name="granted_employees_count" string="Délivré" widget="statinfo"/>
                    </button></div>
                    <widget name="web_ribbon" title="Archivé" bg_color="bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="par ex. Solutionneur"/>
                        </h1>
                    </div>
                    <group>
                        <field name="description" nolabel="1" placeholder="Description du badge" colspan="2"/>
                    </group>
                    <group string="Délivré">
                        <div class="oe_grey" colspan="2">
                            Règles de sécurité définissant qui est autorisé à délivrer manuellement des badges. Non appliqué à l'administrateur.
                        </div>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="rule_auth" widget="radio" on_change="1"/>
                            <field name="rule_auth_user_ids" invisible="rule_auth != 'users'" widget="many2many_tags" on_change="1" can_create="True" can_write="True"/>
                            <field name="rule_auth_badge_ids" invisible="rule_auth != 'having'" widget="many2many_tags" on_change="1" can_create="True" can_write="True"/>
                            <field name="rule_max" invisible="rule_auth == 'nobody'" on_change="1"/>
                            <field name="rule_max_number" invisible="not rule_max or rule_auth == 'nobody'" on_change="1"/>
                            <label for="stat_my_monthly_sending"/>
                            <div>
                                <field name="stat_my_monthly_sending" invisible="rule_auth == 'nobody'" on_change="1"/>
                                <div invisible="remaining_sending == -1" class="oe_grey">
                                    Vous pouvez toujours délivrer <field name="remaining_sending" class="oe_inline"/> badges du mois
                                </div>
                                <div invisible="remaining_sending != -1" class="oe_grey">
                                    Aucune limite mensuelle d'envoi
                                </div>
                            </div>
                        </group>
                    </group>
                    <group string="Récompenser les défis">
                        <field name="challenge_ids" mode="kanban" widget="many2many" nolabel="1" context="{'default_reward_id': id}" colspan="2"/>
                        <field name="level" colspan="2"/>
                    </group>
                    <group id="badge_statistics" string="Statistiques">
                        <group>
                            <field name="granted_count"/>
                            <field name="stat_this_month"/>
                            <field name="granted_users_count"/>
                        </group>
                        <group>
                            <field name="stat_my"/>
                            <field name="stat_my_this_month"/>
                        </group>
                    </group>
                </sheet>
            </form>