                <field name="name"/>
                <field name="date_start" string="Début de validité"/>
                <field name="date_end" string="Fin de validité" on_change="1"/>
                <field name="survey_id" optional="show"/>
                <field name="expiration_status" column_invisible="1"/>
            </list>