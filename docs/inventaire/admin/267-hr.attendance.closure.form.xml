<form string="Clôture de Pointage">
            <header>
                <button name="action_rebuild_month_ventilations" type="object" string="Régénérer ventilations + HS" class="btn-primary" confirm="Régénérer les ventilations et recalculer les heures sup sur toute la période ?"/>
                
            </header>
            
            <sheet>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="date_start" on_change="1"/>
                        <field name="date_end" on_change="1"/>
                    </group>
                    <group>
                        <field name="month" readonly="1"/>
                    </group>
                </group>
            </sheet>
        </form>