                <app data-string="Employees" string="Employés" name="hr">
                    <block title="Employés" name="employees_setting_container">
                        <setting id="presence_control_setting" title="Présence des employés" string="Affichage des présences">
                            <div class="content-group" name="hr_presence_options">
                                <div class="d-flex">
                                    <field name="module_hr_attendance" class="ml16" on_change="1"/>
                                    <label for="module_hr_attendance" class="o_light_label"/>
                                </div>
                                <div class="d-flex">
                                    <field name="hr_presence_control_login" class="ml16"/>
                                    <label for="hr_presence_control_login" class="o_light_label"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="presence_reporting_setting" help="Écran de rapport de présence, contrôle d'adresse e-mail et IP." title="Présences des employés avancées">
                            <field name="module_hr_presence" on_change="1"/>
                            <div class="d-flex mt-1" invisible="not module_hr_presence">
                                <field name="hr_presence_control_email" class="ml16"/>
                                <label for="hr_presence_control_email" class="o_light_label"/>
                            </div>
                            <div class="d-flex" invisible="not module_hr_presence">
                                <field name="hr_presence_control_ip" class="ml16"/>
                                <label for="hr_presence_control_ip" class="o_light_label"/>
                            </div>
                        </setting>
                        <setting id="presence_reporting_setting" help="Définissez le nombre minimum d'e-mails envoyés à afficher comme Présents." title="Présences des employés avancées" string="Condition liée à la présence" invisible="not module_hr_presence or not hr_presence_control_email">
                            <div class="d-flex">
                                <span class="flex-shrink-0 ml8 me-2">E-mails envoyés</span>
                                <field name="hr_presence_control_email_amount" class="ms-2 oe_inline"/>
                            </div>
                        </setting>
                        <setting id="presence_reporting_setting" help="Définissez l'adresse IP qui sera affichée comme Présente. En cas de plusieurs adresses, séparez-les par une virgule." title="Présences des employés avancées" string="Condition liée à la présence" invisible="not module_hr_presence or not hr_presence_control_ip">
                            <div class="d-flex">
                                <span class="flex-shrink-0 ml8 me-2">Adresses IP</span>
                                <field name="hr_presence_control_ip_list" class="ms-2 oe_inline"/>
                            </div>
                        </setting>
                        <setting invisible="not module_hr_presence or not (hr_presence_control_ip or hr_presence_control_email) or (hr_presence_control_ip and hr_presence_control_email)" help="Ce bloc de paramètres est utilisé pour gérer le design frontend."/>
                        <setting help="Enrichir les profils des employés avec des compétences et des CV" id="enrich_employee_setting">
                            <field name="module_hr_skills" on_change="1"/>
                        </setting>
                        <setting id="home_working_setting" help="Afficher les paramètres de télétravail pour chaque employé et les rapports dédiés. Les icônes de présence seront mises à jour en fonction du lieu de télétravail.">
                            <field name="module_hr_homeworking" on_change="1"/>
                        </setting>
                    </block>
                    <block title="Organisation du travail" name="work_organization_setting_container">
                        <setting company_dependent="1" help="Définir le calendrier par défaut de l'entreprise pour gérer l'horaire de vos employés" id="default_company_schedule_setting">
                            <field name="resource_calendar_id" required="1" class="o_light_label" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]" context="{'default_company_id': company_id}" can_create="True" can_write="True"/>
                        </setting>
                    </block>
                <field name="company_country_code" invisible="1"/>
                <block title="Localisation française – Congés" invisible="company_country_code != 'FR'">
                    <setting company_dependent="1" help="Définit le type de congé payé en application pour cette société. Cette information est utilisée pour déterminer la durée des congés des employés à temps partiel.">
                        <field name="l10n_fr_reference_leave_type" class="o_light_label" domain="[('company_id', 'in', [company_id, False])]" context="{'default_company_id': company_id}" required="company_country_code == 'FR'" can_create="True" can_write="True"/>
                    </setting>
                </block>
                    <block title="Mise à jour de droits des employés" name="employee_rights_setting_container">
                        <setting help="Autoriser les employés à mettre à jour leurs propres données." title="Autoriser les employés à mettre à jour leurs propres données.">
                            <field name="hr_employee_self_edit"/>
                        </setting>
                    </block>
                <block title="Contrat" id="hr_contract">
                    <setting string="Délai de préavis du contrat" id="contract_notice_period" title="Nombre de jours avant la date de fin du contrat pour qu'un avertissement d'expiration du contrat soit déclenché.">
                        <field name="contract_expiration_notice_period" class="w-25"/><span>Jours</span>
                    </setting>
                    <setting string="Délai d'expiration du permis de travail" id="work_permit_notice_period" title="Nombre de jours avant la date d'expiration du permis de travail pour qu'un avertissement soit déclenché.">
                        <field name="work_permit_expiration_notice_period" class="w-25"/><span>Jours</span>
                    </setting>
                </block>
                </app>
                <app data-string="Attendances" string="Présences" name="hr_attendance">
                    <block title="Modes" name="kiosk_mode_setting_container">
                        <setting string="Mode kiosque" company_dependent="1" help="Définir la façon dont l'utilisateur sera identifié par l'application.">
                            <field name="attendance_kiosk_mode" required="1" class="w-75"/>
                            <div>
                                <a href="https://www.odoo.com/documentation/master/applications/hr/attendances/hardware.html" target="_blank"><i class="fa fa-fw fa-arrow-right"/>Manuel d'installation</a>
                            </div>
                        </setting>
                        <setting string="Présences depuis le backend" company_dependent="1" help="Permettre aux utilisateurs de pointer à l'entrée/sortie d'Odoo.">
                            <field name="attendance_from_systray" required="1"/>
                        </setting>
                        <setting string="Checkout automatique" company_dependent="1" help="Checkout automatique des employés selon leur horaire de travail avec une tolérance supplémentaire. Ne s’applique pas aux employés avec un horaire flexible.">
                            <field name="auto_check_out"/>
                            <div invisible="not auto_check_out">
                                <span class="me-2">Tolérance</span><field name="auto_check_out_tolerance" class="text-center" style="width: 5ch;"/><span class="ms-2">Heures</span>
                            </div>
                        </setting>
                        <setting string="Gestion des absences" company_dependent="1" help="Si cette option est cochée, les jours non couverts par une présence seront visibles dans le rapport. Ne s’applique pas aux employés avec un horaire flexible.">
                            <field name="absence_management"/>
                        </setting>
                    </block>
                    <block title="Paramètres kiosque">
                        <setting invisible="attendance_kiosk_mode == 'manual'" company_dependent="1" help="Définir la caméra utilisée pour la lecture du code-barres.">
                            <field name="attendance_barcode_source" required="1"/>
                        </setting>
                        <setting string="Afficher l'heure" company_dependent="1" help="Choisir la durée d'affichage du message d'accueil.">
                            <field name="attendance_kiosk_delay" required="1" class="text-center" style="width: 10%; min-width: 4rem;"/><span> secondes</span>
                        </setting>
                        <setting title="Définir des codes PIN dans le formulaire détaillé de l'employé (dans l'onglet Paramètres RH)." invisible="attendance_kiosk_mode == 'barcode'" help="Utiliser les codes PIN (définis sur le profil de l'employé) pour vous enregistrer.">
                            <field name="attendance_kiosk_use_pin"/>
                        </setting>
                        <setting title="Adresse mode kiosque" help="Utilisez cette URL pour accéder au mode kiosque à partir de n'importe quel appareil.">
                            <field name="attendance_kiosk_url" class="o_hr_kiosk_url_media w-100" style="width:100% !important;" widget="CopyClipboardURL"/>
                            <button name="regenerate_kiosk_key" type="object" string="Générer une nouvelle URL" class="btn-link" icon="fa-refresh"/>
                        </setting>
                    </block>
                    <block title="Heures supplémentaires" name="overtime_settings">
                        <setting company_dependent="1">
                            <div class="mt16">
                                <label for="overtime_company_threshold" class="o_form_label">
                                    Temps de tolérance en faveur de l'entreprise
                                </label>
                                <div class="text-muted">
                                    Accorder une période de temps (autour des heures de travail) où les heures supplémentaires ne seront pas comptées, au profit de l'entreprise
                                </div>
                                <span class="me-2">Période</span><field name="overtime_company_threshold" class="text-center" style="width: 5ch;"/><span class="ms-2">Minutes</span>
                                <br/>
                                <br/>
                                <label for="overtime_employee_threshold" class="o_form_label">
                                    Temps de tolérance en faveur de l'employé
                                </label>
                                <div class="text-muted">
                                    Prévoir une période (autour des heures de travail) où le temps supplémentaire ne sera pas déduit, au profit du salarié
                                </div>
                                <span class="me-2">Période </span><field name="overtime_employee_threshold" class="text-center" style="width: 5ch;"/><span> Minutes</span>
                            </div>
                        </setting>
                        <setting title="Afficher les heures supplémentaires." string="Afficher les heures supplémentaires" company_dependent="1" help="Afficher les heures supplémentaires en mode kiosque et sur le profil utilisateur.">
                            <field name="hr_attendance_display_overtime"/>
                        </setting>
                        <setting title="Validation d'heures supplémentaires" string="Validation d'heures supplémentaires" company_dependent="1" help="Peut être converti en Congés (cfr Configuration des Congés).">
                            <field name="attendance_overtime_validation" widget="radio"/>
                        </setting>
                    </block>
                <block title="Question Repas (Kiosk)" name="meal_settings">
                    <setting string="Question repas" company_dependent="0" help="Demander le nombre de repas pris sur place lors du check-out au kiosk.">
                        <field name="kiosk_meal_question_enabled"/>
                    </setting>
                    <setting string="Nombre maximum de repas" company_dependent="0" invisible="not kiosk_meal_question_enabled" help="Nombre maximum de repas qu'un employé peut déclarer par pointage.">
                        <field name="kiosk_meal_max_count" class="text-center" style="width: 5ch;"/>
                    </setting>
                </block>
                </app>
                </form>