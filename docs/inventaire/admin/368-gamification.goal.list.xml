<list string="Liste d'objectifs" decoration-danger="state == 'failed'" decoration-success="state == 'reached'" decoration-muted="state == 'canceled'" create="false">
                <field name="definition_id" column_invisible="True" on_change="1"/>
                <field name="user_id" column_invisible="True"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="current" on_change="1"/>
                <field name="target_goal" on_change="1"/>
                <field name="completeness" widget="progressbar"/>
                <field name="state" column_invisible="True"/>
                <field name="line_id" column_invisible="True"/>
            </list>